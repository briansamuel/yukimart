    "item": [
        {
            "name": "Firebase FCM v1 API",
            "item": [
                {
                    "name": "Send Notification to Token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{firebase_access_token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"message\": {\n    \"token\": \"{{test_fcm_token}}\",\n    \"notification\": {\n      \"title\": \"\ud83d\uded2 Test Notification\",\n      \"body\": \"This is a test notification from Postman\"\n    },\n    \"data\": {\n      \"type\": \"test\",\n      \"source\": \"postman\",\n      \"timestamp\": \"{{$timestamp}}\"\n    },\n    \"android\": {\n      \"priority\": \"high\",\n      \"notification\": {\n        \"color\": \"#009ef7\",\n        \"icon\": \"ic_notification\"\n      }\n    }\n  }\n}"
                        },
                        "url": {
                            "raw": "https://fcm.googleapis.com/v1/projects/{{firebase_project_id}}/messages:send",
                            "protocol": "https",
                            "host": [
                                "fcm",
                                "googleapis",
                                "com"
                            ],
                            "path": [
                                "v1",
                                "projects",
                                "{{firebase_project_id}}",
                                "messages:send"
                            ]
                        },
                        "description": "Send a notification to a specific FCM token using Firebase v1 API"
                    }
                },
                {
                    "name": "Send Notification to Topic",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{firebase_access_token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"message\": {\n    \"topic\": \"admin_notifications\",\n    \"notification\": {\n      \"title\": \"\ud83d\udce2 Admin Notification\",\n      \"body\": \"Broadcast message to all admin users\"\n    },\n    \"data\": {\n      \"type\": \"admin_broadcast\",\n      \"priority\": \"high\",\n      \"timestamp\": \"{{$timestamp}}\"\n    }\n  }\n}"
                        },
                        "url": {
                            "raw": "https://fcm.googleapis.com/v1/projects/{{firebase_project_id}}/messages:send",
                            "protocol": "https",
                            "host": [
                                "fcm",
                                "googleapis",
                                "com"
                            ],
                            "path": [
                                "v1",
                                "projects",
                                "{{firebase_project_id}}",
                                "messages:send"
                            ]
                        },
                        "description": "Send a notification to a topic (all subscribers)"
                    }
                }
            ],
            "description": "Direct Firebase FCM v1 API endpoints"
        },
